# Safe local-development template. Replace with your own project values in .env.local.
# Never put service-role or Supabase secret keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: required for distributed auth limits and account deletion.
# Never prefix this variable with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
